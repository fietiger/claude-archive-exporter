{
  "manifest_version": 3,
  "name": "Claude 会话归档导出",
  "short_name": "Claude 归档",
  "version": "1.3.0",
  "description": "Export Claude conversations to offline ZIP archives with messages, files, artifacts, and raw JSON.",
  "homepage_url": "https://github.com/fietiger/claude-archive-exporter",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "Claude 会话归档导出"
  },
  "host_permissions": ["https://claude.ai/*"],
  "content_scripts": [
    {
      "matches": ["https://claude.ai/chat/*"],
      "js": ["zip.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
